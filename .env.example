# Copy to .env and replace mail placeholders. Never commit real credentials.
# .env is loaded only when Node is started with --env-file=.env.
PORT=4000
TRUST_PROXY_HOPS=0

# SMTP provider supplied by the receiving team.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# true for implicit TLS (normally port 465); false for STARTTLS (normally port 587).
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-username
SMTP_PASS=replace-with-smtp-password
SMTP_FROM=website@local-md.com
SMTP_RECIPIENT=replace-with-inquiry-mailbox@example.com
MED_AUTH_RECIPIENT=replace-with-medical-authorization-mailbox@example.com
